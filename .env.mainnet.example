# Copy to .env.mainnet, fill in the blanks, chmod 600.
# .env.mainnet is gitignored; this example is not -- keep secrets out of it.

# The public https://mainnet.base.org rate-limits the position scan and
# returns 0 positions in ~1.6s -- indistinguishable from an empty market.
# publicnode returns the real result but takes ~15s per scan, so a paid
# endpoint (Alchemy/QuickNode) is the real answer for contested mainnet.
RPC_URL_MAINNET=https://base-rpc.publicnode.com

# Mainnet EVM key (0x + 64 hex). BatchBuyer.owner is immutable and set to the
# deployer, so a contract deployed from a key you later rotate is permanently
# unusable -- settle on the key BEFORE deploying.
PRIVATE_KEY=

# MAINNET Bitcoin address (bc1.../1.../3...). A testnet address is rejected,
# and seized BTC sent to a wrong-network address is unspendable.
RECIPIENT_BTC_ADDRESS=

# Explicitly blank so the shared .env fallback cannot leak signet values in.
# config.ts prefers PRIVATE_KEYS over PRIVATE_KEY, and dotenv reads .env after
# .env.mainnet without overriding -- so an unset plural here silently inherits
# your signet lanes and their BatchBuyers. Empty means "fall back to the
# singular form", which is what a single-lane mainnet deploy wants.
PRIVATE_KEYS=
BATCH_BUYER_ADDRESSES=

# Only watch this market id; empty = all markets.
MARKET_ID=

# Start safe. Flip only after a clean soak.
DRY_RUN=true

# Mainnet economics: unlike signet, these must not be permissive.
# true = only buy auctions the quote marks profitable.
# false = buy at whatever the Dutch auction currently prices, including
# above collateral value. Trades a possible real loss for not waiting on
# decay while another keeper takes the auction. The only remaining bounds
# are MAX_SPEND_USDC and the wallet balance.
REQUIRE_PROFITABLE=true
# Per-auction ceiling. 0 disables it entirely. decideBuy() also refuses any
# auction priced above the wallet balance regardless, so the balance is the
# real backstop -- this cap exists to stop a mispriced auction draining it.
MAX_SPEND_USDC=150
EST_BTC_DELIVERY_FEE_USD=1
TARGET_MARGIN_BPS=0
UNLIMITED_APPROVAL=false

# The public Base RPC will throttle at signet's 500ms. Start conservative.
POLL_INTERVAL_MS=2000
SCAN_CONCURRENCY=5
# How often "is this position in auction?" is re-read from the chain instead of
# from the engine's own openAuctionIds cache. That cache only ever contains
# auctions THIS engine opened, so an auction someone else opened is invisible
# until the next reconcile -- at the 30000 default that is a 30s blind window,
# which on signet is how a competing keeper won #1975 four seconds after our
# last watch line.
#
# NB: reconcile is only evaluated inside a poll cycle, so POLL_INTERVAL_MS is a
# hard floor. Setting this below POLL_INTERVAL_MS just means "every cycle".
# Cost: one inLiquidation read per relevant position per reconcile.
RECONCILE_INTERVAL_MS=2000

WATCH_HEALTH_PCT=88
LOOKBACK_BLOCKS=50000
MAX_SCAN_IDS=5000
POSITION_IDS=

# Filled in after: forge build && NETWORK=mainnet npx tsx src/deploy-batch-buyer.ts
BATCH_BUYER_ADDRESS=

LOG_FILE=
NO_UI=1
WEB_UI=0
