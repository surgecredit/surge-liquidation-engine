# Copy to `.env.testnet`, then run:  npm run testnet
# NETWORK is forced to signet by the script; no need to set it here.

RPC_URL_SIGNET=https://sepolia.base.org

# EVM wallet with Base Sepolia ETH (gas) + testnet USDC (to buy).
PRIVATE_KEY=

# TESTNET Bitcoin address (tb1.../m.../n.../2...) for seized collateral.
RECIPIENT_BTC_ADDRESS=

# Safety: simulate everything until you flip this to false.
DRY_RUN=true

# Monitoring
POLL_INTERVAL_MS=15000
WATCH_HEALTH_PCT=88
LOOKBACK_BLOCKS=50000
MAX_SCAN_IDS=5000
POSITION_IDS=

# Buy economics
EST_BTC_DELIVERY_FEE_USD=1
TARGET_MARGIN_BPS=0
REQUIRE_PROFITABLE=true
MAX_SPEND_USDC=0
UNLIMITED_APPROVAL=false

# Optional: override the LiquidityPool (defaults to the known-good signet pool).
LIQUIDITY_POOL_ADDRESS=

# Optional: override the AuctionHouse address (auto-detected on-chain at startup).
AUCTION_HOUSE_ADDRESS=

# Optional: deployed BatchBuyer -- buys N auctions in one transaction.
# forge build && NETWORK=signet npx tsx src/deploy-batch-buyer.ts
BATCH_BUYER_ADDRESS=

# Logging / UI
LOG_FILE=
NO_UI=

# Serve a browser dashboard at http://localhost:WEB_PORT alongside the terminal UI.
# Enabled by the *:web npm scripts; set here to always run it.
WEB_UI=
WEB_PORT=3000
# No auth on the dashboard. Keep it on 127.0.0.1 unless something in front authenticates.
WEB_HOST=127.0.0.1

# Only monitor positions in this market (leave empty for all markets).
MARKET_ID=
MARKET_NAME=
