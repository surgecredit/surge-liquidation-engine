# ─────────────────────────────────────────────────────────────────────────────
# Surge Liquidation Engine — configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Network: "signet" (Base Sepolia testnet) or "mainnet" (Base).
NETWORK=signet

# RPC endpoints. Public defaults shown; use a dedicated endpoint in production.
RPC_URL_SIGNET=https://sepolia.base.org
RPC_URL_MAINNET=https://mainnet.base.org

# Override the LiquidityPool address used to read market liquidation thresholds.
# Leave empty to use the built-in default. NOTE: the auction SDK's packaged
# signet LiquidityPool reverts on markets(), so on signet the engine defaults to
# the known-good address (0xed96...). Set this only to override that.
LIQUIDITY_POOL_ADDRESS=

# Optional: override the AuctionHouse address. The engine auto-detects the
# correct one on-chain (via VaultManager.auctionHouse()) at startup and warns
# if the SDK's built-in constant is stale, so this is normally unnecessary.
# Set it only if the on-chain lookup fails or you need to force a specific house.
AUCTION_HOUSE_ADDRESS=

# Optional: deployed BatchBuyer (contracts/BatchBuyer.sol). When set, a cycle
# with several buyable auctions sends them as ONE transaction instead of one
# per auction -- one nonce, one block, no submission races. Deploy with:
#   forge build && NETWORK=signet npx tsx src/deploy-batch-buyer.ts
# then approve it to pull USDC from this wallet (the deploy script prints the
# command). Leave empty to keep the per-transaction path.
BATCH_BUYER_ADDRESS=

# EVM wallet that holds Base ETH (for gas) and USDC (to buy). Keep it dedicated
# and funded only with working capital. 0x-prefixed 32-byte hex private key.
PRIVATE_KEY=

# Bitcoin address that receives the seized BTC collateral after a buy.
# MUST match the network: testnet address (tb1.../m.../n.../2...) on signet,
# mainnet address (bc1.../1.../3...) on mainnet. A wrong-network address makes
# the seized BTC unspendable, so the engine refuses to start on a mismatch.
RECIPIENT_BTC_ADDRESS=

# ── Safety ──────────────────────────────────────────────────────────────────
# DRY_RUN=true simulates everything (no checkHealth, no approve, no buy) and is
# the default. Set to false to send real transactions.
DRY_RUN=true

# ── Monitoring ──────────────────────────────────────────────────────────────
# How often to poll, in milliseconds.
POLL_INTERVAL_MS=15000

# Positions at/above this health % are shown on the watch list. 100% = at the
# liquidation boundary. "beyond 88%" => WATCH_HEALTH_PCT=88.
WATCH_HEALTH_PCT=88

# How many blocks back listAuctions scans for LogAuctionCreated events.
LOOKBACK_BLOCKS=50000

# Position discovery is contract-only and automatic: the engine resolves the
# PositionNFT from the VaultManager, reads totalSupply, and multicalls health
# across all ids each poll. Leave POSITION_IDS empty for that. Set a
# comma-separated list to health-check only those specific ids instead.
POSITION_IDS=

# When auto-discovering, cap how many position ids to read per poll. If the
# protocol has more positions than this, the most recent ids are scanned.
MAX_SCAN_IDS=5000

# ── Buy economics ───────────────────────────────────────────────────────────
# Assumed BTC miner fee per delivery, in USD (used in profit quote).
EST_BTC_DELIVERY_FEE_USD=1

# Required net profit as a fraction of collateral value, in bps (300 = 3%).
TARGET_MARGIN_BPS=0

# If true, only buy auctions the quote marks profitable. If false, buy any
# liquidatable auction you can afford, ignoring the profit gate.
REQUIRE_PROFITABLE=true

# Hard per-buy USDC cap. 0 = no cap (still bounded by wallet balance).
MAX_SPEND_USDC=0

# Approve an unlimited USDC allowance to the AuctionHouse once, instead of
# approving the exact price before each buy. false is safer.
UNLIMITED_APPROVAL=false

# ── Logging / UI ────────────────────────────────────────────────────────────
# Optional file to also append the feed to (plain text).
LOG_FILE=

# Set to 1 to force plain line-logging instead of the full-screen terminal UI
# (auto-selected when stdout is not a TTY).
NO_UI=

# Serve a browser dashboard at http://localhost:WEB_PORT alongside the terminal UI.
# Enabled by the *:web npm scripts; set here to always run it.
WEB_UI=
WEB_PORT=3000
# No auth on the dashboard. Keep it on 127.0.0.1 unless something in front authenticates.
WEB_HOST=127.0.0.1

# ── Multi-lane and market filter (optional) ──────────────────────────────────
# Several keys, comma-separated, each with its own BatchBuyer at the same index
# in BATCH_BUYER_ADDRESSES. Leave both empty to use PRIVATE_KEY / BATCH_BUYER_ADDRESS.
PRIVATE_KEYS=
BATCH_BUYER_ADDRESSES=
# Only watch positions in this market id (empty = all markets). MARKET_NAME is a display label.
MARKET_ID=
MARKET_NAME=

# ── Tuning (optional, defaults shown) ────────────────────────────────────────
# SCAN_CONCURRENCY=10          parallel per-position reads; lower it if the RPC rate-limits
# SCAN_TIMEOUT_MS=45000        give up on a position scan after this long
# RECONCILE_INTERVAL_MS=30000  re-read "in auction?" from chain (catches auctions others opened)
# STATUS_REFRESH_MS=15000      wallet ETH / USDC / allowance refresh
# NONCE_SYNC_MS=10000          nonce cursor resync from chain
# OPEN_AND_BUY_SAME_TX=1       BatchBuyer opens and buys in one tx; 0 = two transactions.
#                              Only used when REQUIRE_PROFITABLE=false and MAX_SPEND_USDC=0,
#                              because the auction cannot be quoted before it is opened.
# SAME_TX_CHUNK_SIZE=6         ids per same-tx BatchBuyer call (gas cap per tx)
# PIPELINE_CHUNKS=0            1 = send all chunks without waiting for receipts
# SCAN_AUCTION_LOGS=0          leave 0: the SDK event ABI does not decode current logs
# src/scan.ts only: SCAN_MIN_HEALTH=70, SCAN_LIMIT=40
